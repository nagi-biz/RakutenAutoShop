---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TIKTOK_PRODUCTS, type TiktokProduct } from '../../data/tiktok-products';
import { formatYen } from '../../lib/genres';

export function getStaticPaths() {
  return TIKTOK_PRODUCTS.map((p) => ({
    params: { slug: p.slug },
    props: { product: p },
  }));
}

interface Props {
  product: TiktokProduct;
}
const { product } = Astro.props;
const base = import.meta.env.BASE_URL;
const title = `${product.name} — TikTokで紹介した商品｜楽天お買い物ラボ`;
const description = `${product.description} 価格は${formatYen(product.price)}（${product.featuredDate}確認）。`;
const image = `${base}/products/${product.slug}.jpg`;
const dateLabel = product.featuredDate.replaceAll('-', '/');
---

<BaseLayout title={title} description={description} image={image}>
  <a class="tp-back" href={`${base}/products/`}>← TikTokで紹介した商品一覧へ</a>
  <article class="tp-detail">
    <img class="tp-detail-img" src={image} alt={product.name} />
    <span class="genre-chip">{product.genre}</span>
    <h1>{product.name}</h1>
    <p>{product.description}</p>
    <dl class="tp-facts">
      <div>
        <dt>価格</dt>
        <dd>
          <span class="tp-price">{formatYen(product.price)}</span>
          {product.priceNote && <span class="tp-note">（{product.priceNote}）</span>}
        </dd>
      </div>
      <div>
        <dt>送料</dt>
        <dd>{product.shipping}</dd>
      </div>
      <div>
        <dt>ショップ</dt>
        <dd>{product.shopName}</dd>
      </div>
      <div>
        <dt>TikTok紹介</dt>
        <dd>{dateLabel}・{product.account}</dd>
      </div>
    </dl>
    <a class="tp-buy" href={product.affiliateUrl} rel="nofollow sponsored" target="_blank">
      楽天市場で見る・買う
    </a>
    <p class="tp-note">
      ※ 価格・送料は{dateLabel}に確認した時点の情報です。最新の価格は楽天市場の商品ページでご確認ください。リンク先は楽天アフィリエイトリンクです。
    </p>
    {
      product.tiktokUrl && (
        <a class="tp-video-link" href={product.tiktokUrl} target="_blank" rel="noopener">
          ▶ この商品を紹介したTikTok動画を見る（{product.account}）
        </a>
      )
    }
  </article>
</BaseLayout>

---
import { getCollection, render } from 'astro:content';
import fs from 'node:fs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RankCard from '../../components/RankCard.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  // 英語版が存在する記事は、言語スイッチャー／hreflang のリンク先として渡す
  const enIds = new Set((await getCollection('articlesEn')).map((a) => a.id));
  return articles.map((article) => ({
    params: { id: article.id },
    props: { article, hasEn: enIds.has(article.id) },
  }));
}

const { article, hasEn } = Astro.props;
const { Content } = await render(article);
// PR 画像（pr-image.mjs が public/pr/<記事ID>.png に作る）。あれば記事の先頭と SNS のリンク表示に使う
const pr = fs.existsSync(`public/pr/${article.id}.png`) ? `${import.meta.env.BASE_URL}/pr/${article.id}.png` : null;
// ランキングカードは本文より前に、順位（rank）昇順で並べる
const products = [...article.data.products].sort((a, b) => a.rank - b.rank);
---

<BaseLayout
  title={`${article.data.title} — 楽天お買い物ラボ`}
  image={pr ?? undefined}
  altPath={hasEn ? `/en/articles/${article.id}/` : undefined}
>
  <article class="article">
    {pr && <img class="article-hero" src={pr} alt={article.data.title} width="1200" height="630" />}
    <h1>{article.data.title}</h1>
    <p class="article-date">
      {article.data.pubDate.toLocaleDateString('ja-JP')}
    </p>
    <h2>🏆 ランキング商品（順位順）</h2>
    <ol class="rank-list">
      {
        products.map((p, i) => (
          <RankCard
            rank={i + 1}
            sourceRank={p.rank}
            rankSuffix="位"
            name={p.name}
            imageUrl={p.imageUrl}
            price={p.price}
            shopName={p.shopName}
            affiliateUrl={p.affiliateUrl}
            category={p.category}
            lang="ja"
          />
        ))
      }
    </ol>
    <Content />
  </article>
</BaseLayout>

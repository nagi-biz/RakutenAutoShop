---
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getUI } from '../../i18n/ui';

const t = getUI('en');

const allArticles = await getCollection('articles');
// 英語版がある記事は英語ページへリンクし、英語タイトルで表示する
const enById = new Map((await getCollection('articlesEn')).map((a) => [a.id, a]));

// カードのサムネイル: PR 画像があればそれ、無ければ先頭商品の画像を使う。
// 商品画像はサムネイル用パラメータ（_ex=128x128）が小さいため、表示用に大きなサイズを要求する。
const base = import.meta.env.BASE_URL;
const thumbOf = (article: (typeof allArticles)[number]) =>
  fs.existsSync(`public/pr/${article.id}.png`)
    ? `${base}/pr/${article.id}.png`
    : article.data.products[0].imageUrl.replace(/_ex=\d+x\d+/, '_ex=400x400');

const articles = allArticles
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((article) => {
    const en = enById.get(article.id);
    return {
      href: en
        ? `${base}/en/articles/${article.id}/`
        : `${base}/articles/${article.id}/`,
      title: en ? en.data.title : article.data.title,
      pubDate: article.data.pubDate,
      thumb: thumbOf(article),
    };
  });
---

<BaseLayout title={t.homeTitle} lang="en" altPath="/">
  <h1>{t.homeHeading}</h1>
  <p>{t.homeIntro}</p>
  <p>
    New to shopping on Rakuten Ichiba from outside Japan?
    <a href={`${import.meta.env.BASE_URL}/en/guide/`}>Read our How to Buy guide</a>.
    Articles shown with an English title have a full English version; the rest
    link to the Japanese article for now.
  </p>
  <ul class="card-grid">
    {
      articles.map((article) => (
        <li class="article-card">
          <a href={article.href}>
            <img src={article.thumb} alt="" loading="lazy" />
            <div class="article-card-body">
              <h2>{article.title}</h2>
              <p class="article-card-date">
                {article.pubDate.toLocaleDateString(t.dateLocale)}
              </p>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
  {articles.length === 0 && <p>{t.homeEmpty}</p>}
</BaseLayout>

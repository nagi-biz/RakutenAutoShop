---
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getUI } from '../../i18n/ui';
import { GENRES, genreCounts } from '../../lib/genres';

const t = getUI('en');

const allArticles = await getCollection('articles');
const counts = genreCounts(allArticles);
// 英語版がある記事は英語ページへリンクし、英語タイトルで表示する
const enById = new Map((await getCollection('articlesEn')).map((a) => [a.id, a]));

// カードのサムネイル: PR 画像があればそれ、無ければ先頭商品の画像を使う。
// 商品画像はサムネイル用パラメータ（_ex=128x128）が小さいため、表示用に大きなサイズを要求する。
const base = import.meta.env.BASE_URL;
const thumbOf = (article: (typeof allArticles)[number]) =>
  fs.existsSync(`public/pr/${article.id}.png`)
    ? `${base}/pr/${article.id}.png`
    : article.data.products[0].imageUrl.replace(/_ex=\d+x\d+/, '_ex=400x400');

const articles = allArticles
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((article) => {
    const en = enById.get(article.id);
    return {
      href: en
        ? `${base}/en/articles/${article.id}/`
        : `${base}/articles/${article.id}/`,
      title: en ? en.data.title : article.data.title,
      pubDate: article.data.pubDate,
      thumb: thumbOf(article),
    };
  });
---

<BaseLayout title={t.homeTitle} lang="en" altPath="/">
  <section class="event-banner" id="bf-banner">
    <p class="event-banner-label">🖤 BLACK FRIDAY 🖤</p>
    <h2 class="event-banner-title">Rakuten Black Friday — starts Nov 19, 8:00 PM JST</h2>
    <p class="event-banner-meta">
      Entry is open now! The sale runs until Nov 25, 1:59 AM JST.<br />
      Earn boosted points by shopping around, plus up to 50% OFF coupons in the first 2 hours.
    </p>
    <a
      class="event-banner-btn"
      href="https://event.rakuten.co.jp/campaign/point-up/blackfriday/"
      target="_blank"
      rel="sponsored noopener">Enter on the official event page</a
    >
  </section>
  <script is:inline>
    (function () {
      if (Date.now() > new Date('2026-11-25T01:59:00+09:00').getTime()) {
        var el = document.getElementById('bf-banner');
        if (el) el.style.display = 'none';
      }
    })();
  </script>

  <h1>{t.homeHeading}</h1>
  <p>{t.homeIntro}</p>
  <p>
    New to shopping on Rakuten Ichiba from outside Japan?
    <a href={`${import.meta.env.BASE_URL}/en/guide/`}>Read our How to Buy guide</a>.
    Articles shown with an English title have a full English version; the rest
    link to the Japanese article for now.
  </p>

  <h2 class="section-heading">Browse by genre</h2>
  <ul class="genre-grid">
    {
      GENRES.map((genre) => (
        <li class="genre-card">
          <a href={`${base}/en/genre/${genre.key}/`}>
            <span class="genre-card-icon">{genre.icon}</span>
            <span class="genre-card-name">{genre.en}</span>
            <span class="genre-card-count">{counts.get(genre.key) ?? 0} items</span>
          </a>
        </li>
      ))
    }
  </ul>

  <h2 class="section-heading">Latest articles</h2>
  <ul class="card-grid">
    {
      articles.map((article) => (
        <li class="article-card">
          <a href={article.href}>
            <img src={article.thumb} alt="" loading="lazy" />
            <div class="article-card-body">
              <h2>{article.title}</h2>
              <p class="article-card-date">
                {article.pubDate.toLocaleDateString(t.dateLocale)}
              </p>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
  {articles.length === 0 && <p>{t.homeEmpty}</p>}
</BaseLayout>

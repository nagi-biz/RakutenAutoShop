---
import { getCollection, render } from 'astro:content';
import fs from 'node:fs';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getUI } from '../../../i18n/ui';

export async function getStaticPaths() {
  const articles = await getCollection('articlesEn');
  return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}

const t = getUI('en');
const { article } = Astro.props;
const { Content } = await render(article);
// PR 画像は日本語版と共通（public/pr/<記事ID>.png）。あれば記事の先頭と SNS のリンク表示に使う
const pr = fs.existsSync(`public/pr/${article.id}.png`) ? `${import.meta.env.BASE_URL}/pr/${article.id}.png` : null;
---

<BaseLayout
  title={`${article.data.title} — ${t.siteName}`}
  lang="en"
  altPath={`/articles/${article.id}/`}
  image={pr ?? undefined}
>
  <article class="article">
    {pr && <img class="article-hero" src={pr} alt={article.data.title} width="1200" height="630" />}
    <h1>{article.data.title}</h1>
    <p class="article-date">
      {article.data.pubDate.toLocaleDateString(t.dateLocale)}
    </p>
    <Content />
    <h2>{t.productsHeading}</h2>
    <ol class="product-list">
      {
        article.data.products.map((p) => (
          <li class="product-card">
            <a class="product-main" href={p.affiliateUrl} rel="nofollow sponsored" target="_blank">
              <img src={p.imageUrl} alt={p.name} loading="lazy" />
              <strong class="product-name">{p.name}</strong>
            </a>
            <div class="product-meta">
              {p.shopName} / <span class="price">¥{p.price.toLocaleString(t.dateLocale)}</span>
            </div>
            <a class="btn-buy" href={p.affiliateUrl} rel="nofollow sponsored" target="_blank">
              {t.viewOnRakuten}
            </a>
          </li>
        ))
      }
    </ol>
  </article>
</BaseLayout>

---
import { getCollection, render } from 'astro:content';
import fs from 'node:fs';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RankCard from '../../../components/RankCard.astro';
import { getUI } from '../../../i18n/ui';

export async function getStaticPaths() {
  const articles = await getCollection('articlesEn');
  return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}

const t = getUI('en');
const { article } = Astro.props;
const { Content } = await render(article);
// PR 画像は日本語版と共通（public/pr/<記事ID>.png）。あれば記事の先頭と SNS のリンク表示に使う
const pr = fs.existsSync(`public/pr/${article.id}.png`) ? `${import.meta.env.BASE_URL}/pr/${article.id}.png` : null;
// Ranked product cards come before the body text, sorted by rank ascending
const products = [...article.data.products].sort((a, b) => a.rank - b.rank);
---

<BaseLayout
  title={`${article.data.title} — ${t.siteName}`}
  lang="en"
  altPath={`/articles/${article.id}/`}
  image={pr ?? undefined}
>
  <article class="article">
    {pr && <img class="article-hero" src={pr} alt={article.data.title} width="1200" height="630" />}
    <h1>{article.data.title}</h1>
    <p class="article-date">
      {article.data.pubDate.toLocaleDateString(t.dateLocale)}
    </p>
    <h2>🏆 Ranked products</h2>
    <ol class="rank-list">
      {
        products.map((p, i) => (
          <RankCard
            rank={i + 1}
            sourceRank={p.rank}
            name={p.name}
            imageUrl={p.imageUrl}
            price={p.price}
            shopName={p.shopName}
            affiliateUrl={p.affiliateUrl}
            category={p.category}
            lang="en"
          />
        ))
      }
    </ol>
    <Content />
  </article>
</BaseLayout>

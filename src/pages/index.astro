---
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';
import SeasonalBanner from '../components/SeasonalBanner.astro';
import CampaignBanner from '../components/CampaignBanner.astro';
import { GENRES, genreCounts } from '../lib/genres';
import { FEATURES } from '../data/features';
import { TIKTOK_PRODUCTS } from '../data/tiktok-products';

const allArticles = await getCollection('articles');
const articles = allArticles.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const counts = genreCounts(allArticles);

// カードのサムネイル: PR 画像があればそれ、無ければ先頭商品の画像を使う。
// 商品画像はサムネイル用パラメータ（_ex=128x128）が小さいため、表示用に大きなサイズを要求する。
const base = import.meta.env.BASE_URL;
const thumbOf = (article: (typeof articles)[number]) =>
  fs.existsSync(`public/pr/${article.id}.png`)
    ? `${base}/pr/${article.id}.png`
    : article.data.products[0].imageUrl.replace(/_ex=\d+x\d+/, '_ex=400x400');
---

<BaseLayout title="楽天お買い物ラボ — 今売れているものまとめ" lang="ja" altPath="/en/">
  <SeasonalBanner lang="ja" />
  <CampaignBanner lang="ja" />

  <h1><span data-seasonal-accent hidden>🎄 </span>今売れているものまとめ</h1>
  <p>楽天ランキングをもとに、話題の商品を毎日ピックアップして紹介しています。</p>

  <h2 class="section-heading">ジャンルから探す</h2>
  <ul class="genre-grid">
    {
      GENRES.map((genre) => (
        <li class="genre-card">
          <a href={`${base}/genre/${genre.key}/`}>
            <span class="genre-card-icon">{genre.icon}</span>
            <span class="genre-card-name">{genre.ja}</span>
            <span class="genre-card-count">{counts.get(genre.key) ?? 0}件</span>
          </a>
        </li>
      ))
    }
  </ul>

  <h2 class="section-heading">特集</h2>
  <ul class="feature-grid">
    {
      FEATURES.map((f) => {
        const fp = TIKTOK_PRODUCTS.find((p) => p.featureSlug === f.slug);
        return (
          <li class="feature-card">
            <a href={`${base}/features/${f.slug}/`}>
              {fp && <img src={`${base}/products/${fp.slug}.jpg`} alt="" loading="lazy" />}
              <span class="feature-card-body">
                <span class="feature-card-title">
                  {f.emoji} {f.title.ja}
                </span>
                <span class="feature-card-intro">{f.intro.ja}</span>
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>

  <h2 class="section-heading">TikTokで紹介した商品</h2>
  <p>
    TikTok「ALICE World」の動画で紹介した商品は
    <a href={`${base}/products/`}>TikTokで紹介した商品まとめ</a>
    から楽天市場で直接購入できます。
  </p>

  <h2 class="section-heading">新着記事</h2>
  <ul class="card-grid">
    {
      articles.map((article) => (
        <li class="article-card">
          <a href={`${base}/articles/${article.id}/`}>
            <img src={thumbOf(article)} alt="" loading="lazy" />
            <div class="article-card-body">
              <h2>{article.data.title}</h2>
              <p class="article-card-date">
                {article.data.pubDate.toLocaleDateString('ja-JP')}
              </p>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
  {articles.length === 0 && <p>まだ記事がありません。</p>}
</BaseLayout>

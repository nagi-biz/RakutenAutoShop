---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allArticles = await getCollection('articles');
const articles = allArticles.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="楽天お買い物ラボ — 今売れているものまとめ">
  <h1>今売れているものまとめ</h1>
  <p>楽天ランキングをもとに、話題の商品を毎日ピックアップして紹介しています。</p>
  <ul style="list-style:none; padding:0;">
    {
      articles.map((article) => (
        <li style="margin-bottom:1.5rem; padding-bottom:1.5rem; border-bottom:1px solid #e5e2da;">
          <a
            href={`${import.meta.env.BASE_URL}/articles/${article.id}/`}
            style="text-decoration:none; color:inherit;"
          >
            <h2 style="margin:0 0 0.3rem;">{article.data.title}</h2>
            <p style="margin:0; color:#666; font-size:0.9rem;">
              {article.data.pubDate.toLocaleDateString('ja-JP')}
            </p>
          </a>
        </li>
      ))
    }
  </ul>
  {articles.length === 0 && <p>まだ記事がありません。</p>}
</BaseLayout>

---
import { getUI, otherLang, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** ページの言語。既定は 'ja' */
  lang?: Lang;
  /**
   * 他言語版ページのパス（ベースURLを含まない、'/' 始まり）。
   * 例: 日本語トップからは '/en/'、英語トップからは '/'。
   * 指定がある場合、言語スイッチャーはそこへリンクし、hreflangも出力する。
   * 指定がない場合、スイッチャーは他言語のトップページへリンクする。
   */
  altPath?: string;
}
const {
  title,
  description,
  image,
  lang = 'ja',
  altPath,
} = Astro.props;
const t = getUI(lang);
const pageDescription = description ?? t.defaultDescription;
const ogImage = image ? new URL(image, Astro.site).href : null;

const base = import.meta.env.BASE_URL;
const other = otherLang(lang);

// ヘッダーのサイト名リンク先（自言語のトップ）
const homeHref = lang === 'ja' ? `${base}` : `${base}/en/`;

// 言語スイッチャーのリンク先
const switcherHref = altPath
  ? `${base}${altPath}`
  : other === 'en'
    ? `${base}/en/`
    : `${base}`;

// hreflang（他言語版があるページのみ出力）
const selfUrl = new URL(Astro.url.pathname, Astro.site).href;
const altUrl = altPath ? new URL(`${base}${altPath}`, Astro.site).href : null;
const defaultUrl = lang === 'ja' ? selfUrl : altUrl;

// ナビ: ランキングページは現状日本語のみのため、英語ページからも日本語版へリンクする。
// 英語ページには買い方ガイドへのリンクを追加する。
const navItems =
  lang === 'ja'
    ? [
        { label: t.navNew, href: `${base}/ranking/new/` },
        { label: t.navPopular, href: `${base}/ranking/popular/` },
      ]
    : [
        { label: t.navNew, href: `${base}/ranking/new/` },
        { label: t.navPopular, href: `${base}/ranking/popular/` },
        { label: t.navGuide, href: `${base}/en/guide/` },
      ];
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={t.siteName}
      href={`${base}/rss.xml`}
    />
    {
      altUrl && (
        <>
          <link rel="alternate" hreflang={lang} href={selfUrl} />
          <link rel="alternate" hreflang={other} href={altUrl} />
          <link rel="alternate" hreflang="x-default" href={defaultUrl} />
        </>
      )
    }
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <style>
      :root {
        color-scheme: light;
        --bg: #fafaf7;
        --fg: #222;
        --muted: #666;
        --accent: #bf0000;
        --card-bg: #fff;
        --border: #e5e2da;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: 'Hiragino Sans', 'Yu Gothic', system-ui, sans-serif;
        line-height: 1.8;
      }
      header {
        padding: 1.5rem 1rem;
        border-bottom: 1px solid var(--border);
        background: var(--card-bg);
      }
      header a {
        color: var(--fg);
        text-decoration: none;
        font-weight: 700;
        font-size: 1.2rem;
      }
      header .site-header {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.5rem 1.2rem;
      }
      header nav.global-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
      }
      header nav.global-nav a {
        font-weight: 500;
        font-size: 0.95rem;
        color: var(--muted);
        text-decoration: none;
      }
      header nav.global-nav a:hover {
        color: var(--accent);
      }
      header a.lang-switch {
        margin-left: auto;
        font-weight: 500;
        font-size: 0.9rem;
        color: var(--muted);
        text-decoration: underline;
      }
      header a.lang-switch:hover {
        color: var(--accent);
      }
      main {
        max-width: 760px;
        margin: 0 auto;
        padding: 1.5rem 1rem 4rem;
      }
      footer {
        text-align: center;
        color: var(--muted);
        font-size: 0.8rem;
        padding: 2rem 1rem;
      }
      footer nav {
        margin-bottom: 0.75rem;
      }
      footer nav a {
        color: var(--muted);
        text-decoration: underline;
      }
      footer nav span {
        margin: 0 0.5rem;
      }
      .disclosure {
        font-size: 0.75rem;
        color: var(--muted);
        border: 1px solid var(--border);
        background: var(--card-bg);
        border-radius: 8px;
        padding: 0.75rem 1rem;
        margin-bottom: 1.5rem;
      }
    </style>
  </head>
  <body>
    <header>
      <div class="site-header">
        <a href={homeHref}>{t.siteName}</a>
        <nav class="global-nav">
          {
            navItems.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))
          }
        </nav>
        <a class="lang-switch" href={switcherHref}>{t.switcherLabel}</a>
      </div>
    </header>
    <main>
      <p class="disclosure">
        {t.disclosure}
      </p>
      <slot />
    </main>
    <footer>
      <nav>
        <a href={`${base}/about/`}>{t.footerAbout}</a><span>・</span>
        <a href={`${base}/privacy/`}>{t.footerPrivacy}</a><span>・</span>
        <a href={`${base}/contact/`}>{t.footerContact}</a>
      </nav>
      &copy; {new Date().getFullYear()} {t.siteName}
    </footer>
  </body>
</html>

---
interface Props {
  title: string;
  description?: string;
  image?: string;
}
const { title, description = '楽天ランキングで話題の商品を毎日紹介します。', image } = Astro.props;
const ogImage = image ? new URL(image, Astro.site).href : null;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="楽天お買い物ラボ"
      href={`${import.meta.env.BASE_URL}/rss.xml`}
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <style>
      :root {
        color-scheme: light;
        --bg: #fafaf7;
        --fg: #222;
        --muted: #666;
        --accent: #bf0000;
        --card-bg: #fff;
        --border: #e5e2da;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: 'Hiragino Sans', 'Yu Gothic', system-ui, sans-serif;
        line-height: 1.8;
      }
      header {
        padding: 1.5rem 1rem;
        border-bottom: 1px solid var(--border);
        background: var(--card-bg);
      }
      header a {
        color: var(--fg);
        text-decoration: none;
        font-weight: 700;
        font-size: 1.2rem;
      }
      header .site-header {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.5rem 1.2rem;
      }
      header nav.global-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
      }
      header nav.global-nav a {
        font-weight: 500;
        font-size: 0.95rem;
        color: var(--muted);
        text-decoration: none;
      }
      header nav.global-nav a:hover {
        color: var(--accent);
      }
      main {
        max-width: 760px;
        margin: 0 auto;
        padding: 1.5rem 1rem 4rem;
      }
      footer {
        text-align: center;
        color: var(--muted);
        font-size: 0.8rem;
        padding: 2rem 1rem;
      }
      footer nav {
        margin-bottom: 0.75rem;
      }
      footer nav a {
        color: var(--muted);
        text-decoration: underline;
      }
      footer nav span {
        margin: 0 0.5rem;
      }
      .disclosure {
        font-size: 0.75rem;
        color: var(--muted);
        border: 1px solid var(--border);
        background: var(--card-bg);
        border-radius: 8px;
        padding: 0.75rem 1rem;
        margin-bottom: 1.5rem;
      }
    </style>
  </head>
  <body>
    <header>
      <div class="site-header">
        <a href={`${import.meta.env.BASE_URL}`}>楽天お買い物ラボ</a>
        <nav class="global-nav">
          <a href={`${import.meta.env.BASE_URL}/ranking/new/`}>新着ランキング</a>
          <a href={`${import.meta.env.BASE_URL}/ranking/popular/`}>人気ランキング</a>
        </nav>
      </div>
    </header>
    <main>
      <p class="disclosure">
        本サイトの商品リンクには楽天アフィリエイトプログラムによるアフィリエイトリンクが含まれます。
      </p>
      <slot />
    </main>
    <footer>
      <nav>
        <a href={`${import.meta.env.BASE_URL}/about/`}>運営者情報</a><span>・</span>
        <a href={`${import.meta.env.BASE_URL}/privacy/`}>プライバシーポリシー</a><span>・</span>
        <a href={`${import.meta.env.BASE_URL}/contact/`}>お問い合わせ</a>
      </nav>
      &copy; {new Date().getFullYear()} 楽天お買い物ラボ
    </footer>
  </body>
</html>

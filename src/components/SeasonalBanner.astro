---
import { SEASONAL_EVENT } from '../data/seasonal';

interface Props {
  lang: 'ja' | 'en';
}

const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const ev = SEASONAL_EVENT;

// 補足文を文節単位の段に分ける（文節の途中で改行させないため）。
// 日本語は「。」区切り、英語は「 — 」区切りで分割する。
const metaPhrases = (text: string): string[] => {
  if (text.includes('。')) {
    return text.split(/(?<=。)/).filter((s) => s.length > 0);
  }
  if (text.includes(' — ')) {
    const parts = text.split(' — ');
    return [parts[0] + ' —', ...parts.slice(1)];
  }
  return [text];
};
---

{
  ev && (
    <>
      <section
        class:list={['event-banner', `event-banner--${ev.theme}`]}
        id="seasonal-banner"
        style="display:none"
      >
        <p class="event-banner-label">{ev.label[lang]}</p>
        <h2 class="event-banner-title">{ev.title[lang]}</h2>
        <p class="event-banner-meta">
          {metaPhrases(ev.meta[lang]).map((phrase) => (
            <span class="event-banner-phrase">{phrase}</span>
          ))}
        </p>
        <a class="event-banner-btn" href={`${base}${ev.path}`}>
          {ev.button[lang]}
        </a>
      </section>
      <script is:inline define:vars={{ start: ev.start, end: ev.end }}>
        (function () {
          var now = Date.now();
          if (
            now < new Date(start).getTime() ||
            now > new Date(end).getTime()
          ) {
            return;
          }
          var el = document.getElementById('seasonal-banner');
          if (el) el.style.display = '';
          // 見出しアクセントはこのスクリプトより後ろのDOMにあるため、
          // DOM構築完了を待ってから表示する。
          var showAccents = function () {
            document
              .querySelectorAll('[data-seasonal-accent]')
              .forEach(function (a) {
                a.removeAttribute('hidden');
              });
          };
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', showAccents);
          } else {
            showAccents();
          }
        })();
      </script>
    </>
  )
}
